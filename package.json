{
  "name": "ygpt-local",
  "version": "1.0.0-rc.3",
  "private": true,
  "type": "module",
  "description": "YGPT Local for Windows: local MCP tools, protected snapshots and guided installation",
  "scripts": {
    "start": "node service/supervisor.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "package": "node scripts/package.mjs",
    "check:public": "node scripts/public-audit.mjs"
  },
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@vscode/ripgrep": "1.18.0",
    "ajv": "8.20.0",
    "https-proxy-agent": "9.1.0",
    "playwright": "1.62.1",
    "proper-lockfile": "4.1.2",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  }
}
