<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="YGPT · 确认" Width="420" SizeToContent="Height" MaxHeight="360" MinWidth="380" ResizeMode="NoResize" WindowStyle="ToolWindow"
 Background="#FAFAF8" Foreground="#20252B" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12" ShowActivated="False" Topmost="False" WindowStartupLocation="Manual">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="8,7"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#436D8D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Value" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="11"/><Setter Property="LineHeight" Value="16"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#8A9299"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="VerticalAlignment" Value="Top"/></Style>
 </Window.Resources>
 <Grid Margin="12,10,12,9"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><DockPanel><TextBlock Name="State" DockPanel.Dock="Right" FontSize="9" Foreground="#8A9299" Margin="10,3,0,0"/><TextBlock Name="Title" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel><ComboBox Name="Queue" DisplayMemberPath="label" MinHeight="24" Margin="0,6,0,0" Visibility="Collapsed"/></StackPanel>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="230" Margin="0,6,0,0"><StackPanel>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Name="SourceLabel" Text="来源" Style="{StaticResource Label}" Visibility="Collapsed"/><TextBlock Name="Source" Grid.Column="1" Style="{StaticResource Value}" Visibility="Collapsed"/>
   <TextBlock Text="目标" Grid.Row="1" Style="{StaticResource Label}" Margin="0,4,10,0"/><TextBlock Name="Target" Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Margin="0,4,0,0"/>
   <TextBlock Text="影响" Grid.Row="2" Style="{StaticResource Label}" Margin="0,4,10,0"/><TextBlock Name="Impact" Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Margin="0,4,0,0"/>
   <TextBlock Text="拒绝后" Grid.Row="3" Style="{StaticResource Label}" Margin="0,4,10,0"/><TextBlock Name="Denied" Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Margin="0,4,0,0"/>
  </Grid>
  <TextBlock Name="Risk" Style="{StaticResource Value}" FontSize="10" Foreground="#9C593F" Margin="0,5,0,0" Visibility="Collapsed"/>
  <Expander Name="Technical" Header="Details" IsExpanded="False" Foreground="#7C858D" FontSize="10" Margin="0,5,0,0"><StackPanel><TextBlock Name="Purpose" Style="{StaticResource Value}" Foreground="#69717A"/><TextBlock Name="Privilege" TextWrapping="Wrap" FontSize="10" Foreground="#858D95" Margin="0,4,0,4"/><TextBox Name="Code" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="#F1F3F4" Foreground="#626C76" BorderThickness="0" Padding="8" FontFamily="Consolas, Microsoft YaHei UI" FontSize="10" MaxHeight="100" VerticalScrollBarVisibility="Auto"/><TextBlock Name="Expiry" TextWrapping="Wrap" FontSize="9" Margin="0,6,0,3"/>
  <Expander Name="History" Header="History" IsExpanded="False" Foreground="#8C949B" FontSize="10" Margin="0,4,0,0"><TextBlock Name="HistoryText" TextWrapping="Wrap" LineHeight="16" Margin="0,4,0,0"/></Expander></StackPanel></Expander>
 </StackPanel></ScrollViewer>
 <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><Button Name="Allow" Background="#D8E8F5" BorderBrush="#CBDFEE" Foreground="#294D68" Content="Allow once"/><Button Name="Always" Grid.Column="2" Background="#ECF2F6" BorderBrush="#DCE5EC" Foreground="#466175" Content="Allow in this chat"/><Button Name="Deny" Grid.Column="4" Background="#FFFFFF" BorderBrush="#DCE0E4" Foreground="#505964" Content="Deny"/></Grid>
 <TextBlock Grid.Row="3" Name="Note" FontSize="9" Foreground="#9AA1A7" TextWrapping="Wrap" Margin="0,7,0,0"/>
 </Grid>
</Window>
