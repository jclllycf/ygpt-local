<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="YGPT Local · 确认" Width="440" SizeToContent="Height" MaxHeight="470" MinWidth="400" ResizeMode="NoResize" WindowStyle="ToolWindow"
 Background="#F7FBFE" Foreground="#0F2A44" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" ShowActivated="False" Topmost="False" WindowStartupLocation="Manual"
 TextOptions.TextFormattingMode="Display">
 <!-- First Light (docs/DESIGN_FIRST_LIGHT.md). Every Name below is read by approval-panel.ps1; keep them. -->
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border x:Name="Ring" Margin="-3" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent"/><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"/><Border x:Name="Shade" CornerRadius="9" Background="#0C4A6E" Opacity="0"/><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shade" Property="Opacity" Value="0.06"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shade" Property="Opacity" Value="0.14"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="#0EA5E9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Value" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="13"/><Setter Property="LineHeight" Value="19"/><Setter Property="Foreground" Value="#0F2A44"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#5B6F84"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,1,14,0"/><Setter Property="VerticalAlignment" Value="Top"/></Style>
  <!-- The state chip follows the words the panel writes: sky while it needs you, amber when the outcome needs checking, grey once closed. -->
  <Style x:Key="Chip" TargetType="Border"><Setter Property="Background" Value="#E0F2FE"/><Setter Property="BorderBrush" Value="#BAE6FD"/><Style.Triggers>
   <DataTrigger Binding="{Binding Text, ElementName=State}" Value="执行失败"><Setter Property="Background" Value="#FFF7EA"/><Setter Property="BorderBrush" Value="#F5DDB8"/></DataTrigger>
   <DataTrigger Binding="{Binding Text, ElementName=State}" Value="结果待核实"><Setter Property="Background" Value="#FFF7EA"/><Setter Property="BorderBrush" Value="#F5DDB8"/></DataTrigger>
   <DataTrigger Binding="{Binding Text, ElementName=State}" Value="已拒绝"><Setter Property="Background" Value="#EEF3F7"/><Setter Property="BorderBrush" Value="#DCE5EC"/></DataTrigger>
   <DataTrigger Binding="{Binding Text, ElementName=State}" Value="已过期"><Setter Property="Background" Value="#EEF3F7"/><Setter Property="BorderBrush" Value="#DCE5EC"/></DataTrigger>
  </Style.Triggers></Style>
 </Window.Resources>
 <Grid Margin="16,14,16,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel>
  <DockPanel>
   <!-- The sprout Y and its rising sun on a white tile (small-size cut of assets/icon.svg, tile space 240). -->
   <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="7" BorderBrush="#D5E6F2" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,10,0" SnapsToDevicePixels="True"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#EFF8FE" Offset="1"/></LinearGradientBrush></Border.Background>
    <Viewbox><Canvas Width="240" Height="240"><Path Data="M36,86 C76,88 112,116 118,156 C120,174 120,192 118,206 C116,214 108,214 106,206 C100,168 58,142 36,86 Z"><Path.Fill><LinearGradientBrush MappingMode="Absolute" StartPoint="36,86" EndPoint="114,212"><GradientStop Color="#38BDF8" Offset="0"/><GradientStop Color="#0369A1" Offset="1"/></LinearGradientBrush></Path.Fill></Path><Path Data="M204,78 C198,120 162,158 118,190 C122,152 152,96 204,78 Z"><Path.Fill><LinearGradientBrush MappingMode="Absolute" StartPoint="204,78" EndPoint="118,190"><GradientStop Color="#38BDF8" Offset="0"/><GradientStop Color="#0369A1" Offset="1"/></LinearGradientBrush></Path.Fill></Path><Ellipse Canvas.Left="92" Canvas.Top="28" Width="56" Height="56"><Ellipse.Fill><RadialGradientBrush GradientOrigin="0.39,0.36" Center="0.39,0.36" RadiusX="0.6" RadiusY="0.6"><GradientStop Color="#FFD9AE" Offset="0"/><GradientStop Color="#FDBA74" Offset="0.55"/><GradientStop Color="#FB9A4B" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse></Canvas></Viewbox>
   </Border>
   <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" BorderThickness="1" CornerRadius="10" Padding="8,1,8,2" Margin="10,3,0,0" VerticalAlignment="Top"><TextBlock Name="State" FontSize="11.5" FontWeight="SemiBold" Foreground="#075985"/></Border>
   <TextBlock Name="Title" FontSize="15" FontWeight="SemiBold" Foreground="#0F2A44" TextWrapping="Wrap" LineHeight="21" Margin="0,3,0,0"/>
  </DockPanel>
  <TextBlock Name="Purpose" TextWrapping="Wrap" FontSize="12.5" LineHeight="18" Foreground="#4A5F74" Margin="38,4,0,0"/>
  <ComboBox Name="Queue" DisplayMemberPath="label" MinHeight="28" Margin="0,10,0,0" Visibility="Collapsed"/>
 </StackPanel>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="270" Margin="0,12,0,0" Focusable="False"><StackPanel>
  <Border Background="#FFFFFF" BorderBrush="#E3EEF6" BorderThickness="1" CornerRadius="12" Padding="14,11,14,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Name="SourceLabel" Text="来源" Style="{StaticResource Label}" Margin="0,1,14,7" Visibility="Collapsed"/><TextBlock Name="Source" Grid.Column="1" Style="{StaticResource Value}" Margin="0,0,0,7" Visibility="Collapsed"/>
   <TextBlock Text="目标" Grid.Row="1" Style="{StaticResource Label}"/><TextBlock Name="Target" Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}"/>
   <TextBlock Text="会做什么" Grid.Row="2" Style="{StaticResource Label}" Margin="0,8,14,0"/><TextBlock Name="Impact" Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Margin="0,7,0,0"/>
   <TextBlock Text="如果拒绝" Grid.Row="3" Style="{StaticResource Label}" Margin="0,8,14,0"/><TextBlock Name="Denied" Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Margin="0,7,0,0"/>
  </Grid></Border>
  <!-- Risk is said in words, in amber ink; the band appears only when the panel shows the risk line. -->
  <Border Background="#FFF7EA" BorderBrush="#F5DDB8" BorderThickness="1" CornerRadius="10" Padding="12,7,12,8" Margin="0,8,0,0" Visibility="{Binding Visibility, ElementName=Risk}"><TextBlock Name="Risk" Style="{StaticResource Value}" FontSize="12.5" LineHeight="18" Foreground="#A35A0B" Visibility="Collapsed"/></Border>
  <Expander Name="Technical" Header="技术细节" IsExpanded="False" Foreground="#3E6A8A" FontSize="12" Margin="0,8,0,0"><StackPanel Margin="0,6,0,0"><TextBlock Name="Privilege" TextWrapping="Wrap" FontSize="12" LineHeight="17" Foreground="#4A5F74" Margin="0,0,0,6"/><TextBox Name="Code" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="#EEF6FC" Foreground="#1D4258" BorderBrush="#DCEBF5" BorderThickness="1" Padding="8" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="11.5" MaxHeight="110" VerticalScrollBarVisibility="Auto"/><TextBlock Name="Expiry" TextWrapping="Wrap" FontSize="11.5" LineHeight="16" Foreground="#5B6F84" Margin="0,7,0,3"/>
  <Expander Name="History" Header="最近记录" IsExpanded="False" Foreground="#5B6F84" FontSize="12" Margin="0,4,0,0"><TextBlock Name="HistoryText" TextWrapping="Wrap" FontSize="11.5" LineHeight="17" Foreground="#4A5F74" Margin="0,4,0,0"/></Expander></StackPanel></Expander>
 </StackPanel></ScrollViewer>
 <!-- One primary action. Deny is full height and always plain to see. -->
 <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto" MinWidth="84"/></Grid.ColumnDefinitions><Button Name="Allow" BorderBrush="#0284C7" Foreground="#FFFFFF" Content="允许这一次"><Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0284C7" Offset="0"/><GradientStop Color="#075985" Offset="1"/></LinearGradientBrush></Button.Background></Button><Button Name="Always" Grid.Column="2" Background="#E0F2FE" BorderBrush="#BAE6FD" Foreground="#075985" Content="本对话内允许"/><Button Name="Deny" Grid.Column="4" Background="#FFFFFF" BorderBrush="#BCD3E4" Foreground="#0F2A44" Content="拒绝"/></Grid>
 <TextBlock Grid.Row="3" Name="Note" FontSize="11.5" LineHeight="17" Foreground="#5B6F84" TextWrapping="Wrap" Margin="0,9,0,0"/>
 </Grid>
</Window>
